# ~/.config/tofi/config

font = monospace
font-size = 20

# Полноэкранный режим
width = 100%
height = 100%
anchor = center

# Прозрачный фон на весь экран (затемнение)
background-color = #000000AA

# Без рамки и обводки вообще
border-width = 0
outline-width = 0

# Цвета текста
text-color = #FFFFFF
selection-color = #F92672
prompt-color = #FFFFFF
prompt-text = "run: "

# Отступы внутри
padding-top = 40%
padding-left = 40%

num-results = 5
result-spacing = 16
