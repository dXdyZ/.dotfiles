[global]
    ### Отображение и геометрия ###
    monitor = 0
    follow = mouse
    
    # Геометрия окна
    width = 320
    height = 180
    origin = top-right
    offset = 20x20
    scale = 1
    
    # Прогресс-бары (например, для громкости/яркости)
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 300
    progress_bar_max_width = 300

    # Внешний вид
    transparency = 0         # Оставляем 0, так как прозрачность задаем напрямую в цвете
    separator_height = 2
    padding = 12
    horizontal_padding = 15
    text_icon_padding = 12
    
    ### СИНХРОНИЗАЦИЯ С HYPRLAND ###
    frame_width = 2          # Толщина рамки как у твоих окон
    corner_radius = 10       # Скругление как у твоих окон
    
    # Цвета элементов управления
    separator_color = frame
    sort = yes

    ### Текст и шрифты ###
    font = JetBrains Mono 10
    line_height = 3
    
    # Форматирование (Заголовок жирным, текст на новой строке)
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Иконки ###
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### История и правила ###
    sticky_history = yes
    history_length = 20
    always_run_script = true
    corner_radius_bounds = all

    # Управление мышью
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

# ==========================================
# Обновленные стили рамки под Tokyo Night
# ==========================================

[urgency_low]
    # Низкий приоритет: темный фон, тусклая рамка
    background = "#24283bc7"
    foreground = "#545c7e"
    frame_color = "#414868aa"
    highlight = "#414868"
    timeout = 4

[urgency_normal]
    # Обычные уведомления: Тот самый синий цвет из Hyprland с альфой ee
    background = "#24283bc7"
    foreground = "#c0caf5"
    frame_color = "#7aa2f7ee"   # Изменили с фиолетового на чистый синий
    highlight = "#7aa2f7"
    timeout = 6

[urgency_critical]
    # Критические ошибки: Красный Tokyo Night акцент, чтобы отличался от синего
    background = "#24283bc7"
    foreground = "#f8f8f2"
    frame_color = "#f7768eee"   # Фирменный красный/коралловый для алертов
    highlight = "#f7768e"
    timeout = 0
