# ~/.config/tofi/config

font = monospace
font-size = 20

# Полноэкранный режим
width = 100%
height = 100%
anchor = center

# Прозрачный фон на весь экран (затемнение)
background-color = #000000AA

# Без рамки и обводки вообще
border-width = 0
outline-width = 0

# Цвета текста - Tokyo Night
text-color = #c0caf5
selection-color = #7aa2f7
prompt-color = #7aa2f7
prompt-text = "❯ "

# Отступы внутри - ЦЕНТРИРУЕМ НОРМАЛЬНО
padding-top = 30%
padding-left = 40%
padding-right = 10%
padding-bottom = 30%

num-results = 8
result-spacing = 12

